# App name
APP_VERSION_NAME=""

# Mediator settings
# Expected value: a did:web value
# e.g., did:web:mediator.goodcompany.com
DEFAULT_MEDIATOR_DID=""
# Expected value: a JSON string 
# containing the mediator DID and label
# e.g., {"did:web:mediator1.goodcompany.com":"Mediator 1", "did:web:mediator2.goodcompany.com":"Mediator 2"}
# You can add more than one mediator to switch between them
DEFAULT_MEDIATORS=""

# Control Plane API Server for discovery and channel management
# Expected value: a did:web value
# e.g., did:web:controlplane.goodcompany.com
CONTROL_PLANE_DID=""

# Matrix homeserver URL for chat functionality
# e.g., https://matrix.goodcompany.com
MATRIX_HOMESERVER=""

# Firebase settings to enable push notification
# You can get the values from the downloaded plist and json files
# in the Firebase iOS and Android app
FIREBASE_PROJECT_ID=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_STORAGE_BUCKET=""

FIREBASE_IOS_APIKEY=""
FIREBASE_IOS_APP_ID=""
FIREBASE_IOS_BUNDLE_ID=""

FIREBASE_ANDROID_APIKEY=""
FIREBASE_ANDROID_APP_ID=""

# Optional environment variables 

# App settings
BIOMETRICS_ENABLED=""
FOREGROUND_NOTIFICATIONS_ENABLED=""

# Chat settings
CHAT_ACTIVITY_EXPIRES_IN_SECONDS=""
CHAT_IMAGE_MAX_SIZE=""
CHAT_IMAGE_QUALITY_PERCENT=""
CHAT_PRESENCE_SEND_INTERVAL_IN_SECONDS=""
MATRIX_MEDIA_MAX_CACHE_MB=""
MATRIX_MEDIA_CACHE_TTL_DAYS=""

## Profile settings
PROFILE_IMAGE_MAX_SIZE=""
PROFILE_IMAGE_QUALITY_PERCENT=""

## Debug settings
TAPS_TO_UNLOCK_DEBUG=""
DATABASE_LOGGING_ENABLED=""
MAX_LOG_MEMORY_ENTRIES=""

## Marketplace settings
MARKETPLACE_QR_PREFIX=""

## OOB FLOW
DIRECT_INTERACTIVE_OOB_TYPE=""

## Individual (1:1) chat transports
# Expected value: a JSON array of transport identifiers ("didcomm" or "matrix").
# - With more than one entry, the register-offer screen shows a picker.
# - With a single entry, that transport is used and the picker is hidden.
# e.g., ["didcomm","matrix"]
ENABLED_INDIVIDUAL_CHAT_TRANSPORTS=""

## -------------------------------------------------
## Cierge Integration Specific Environment Variables
## -------------------------------------------------

# JSON map of sha256(mnemonic) → additional information.
# Each key is the lowercase hex sha256 digest of the mnemonic string and each
# value is a map of additional information. Currently supported option:
#   ciergeConnectorDid – DID of the Cierge connector agent to use for that wallet.
WALLET_CONFIG='{"<sha256_of_mnemonic>": {"ciergeConnectorDid": "<did:key:cierge-connector-did>", "offers": {"work":"<mnemonic>","personal":"<mnemonic>"}}}'
